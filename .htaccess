# Apache config for OVH Web Hosting (machines-for-sale.pk)
# Tested with .ovhconfig: app.engine=php / container.image=php-5.6

# ---------- Block node_modules ----------
RedirectMatch 404 ^/node_modules/.*$

# ---------- Force HTTPS ----------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---------- Force www → apex ----------
RewriteCond %{HTTP_HOST} ^www\.machines-for-sale\.pk$ [NC]
RewriteRule ^(.*)$ https://machines-for-sale.pk/$1 [R=301,L]

# ---------- index.html → / ----------
RewriteRule ^index\.html$ https://machines-for-sale.pk/ [R=301,L]

# ---------- DirectoryIndex ----------
DirectoryIndex index.html urdu.html

# ---------- Custom 404 ----------
ErrorDocument 404 /404.html

# ---------- Compression (gzip) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Browser cache ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 hour"
  ExpiresByType image/jpeg                    "access plus 6 months"
  ExpiresByType image/png                     "access plus 6 months"
  ExpiresByType image/webp                    "access plus 6 months"
  ExpiresByType image/svg+xml                 "access plus 6 months"
  ExpiresByType image/x-icon                  "access plus 6 months"
  ExpiresByType text/css                      "access plus 1 month"
  ExpiresByType application/javascript        "access plus 1 month"
  ExpiresByType font/woff2                    "access plus 6 months"
  ExpiresByType font/woff                     "access plus 6 months"
  ExpiresByType text/html                     "access plus 4 hours"
  ExpiresByType application/json              "access plus 1 hour"
  ExpiresByType application/xml               "access plus 1 hour"
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|css|js)$">
    Header set Cache-Control "public, max-age=15552000, immutable"
  </FilesMatch>

  # HTML cache with stale-while-revalidate
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=14400, stale-while-revalidate=86400"
  </FilesMatch>

  # Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src https://www.google.com https://www.youtube.com; connect-src 'self'; font-src 'self'"

  # Content-Language signals for Google (hreflang reinforcement)
  SetEnvIf Request_URI "^/ur/" LANG_UR=1
  SetEnvIf Request_URI "^/urdu\.html$" LANG_UR=1
  Header set Content-Language "ur" env=LANG_UR
</IfModule>

# ---------- MIME types ----------
AddType application/xml             .xml
AddType application/json            .json
AddType text/plain                  .txt
AddType image/svg+xml               .svg
